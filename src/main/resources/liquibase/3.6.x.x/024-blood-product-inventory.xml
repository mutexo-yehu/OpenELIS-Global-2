<?xml version="1.0" encoding="UTF-8"?>
<!--
    Blood product inventory: blood components the lab stocks, one row per
    physical unit, reservations of a unit for a patient, and an append-only
    traceability trail of everything that happened to each unit.

    Site-neutral: four generic component types are seeded, but no ISBT 128
    product codes (the ICCBBA product database is licensed, so each site maps
    its own codes), and the five test settings are empty until a site names its
    own catalogue codes.

    patient_id columns reference clinlims.patient. The crossmatch result is kept
    as a plain id without a foreign key: results belong to the results module,
    and a constraint here must never make an ordinary result edit fail.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

    <changeSet id="bloodbank-001-product-type" author="openelisglobal">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="blood_product_type" schemaName="clinlims"/></not>
        </preConditions>
        <comment>Component classes the lab stocks</comment>
        <createTable tableName="blood_product_type" schemaName="clinlims">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="code" type="VARCHAR(40)"><constraints nullable="false" unique="true" uniqueConstraintName="uq_blood_product_type_code"/></column>
            <column name="name" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="component_class" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="requires_crossmatch" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="NOW()"/>
        </createTable>
        <sql>ALTER TABLE clinlims.blood_product_type ADD CONSTRAINT chk_blood_product_type_class
            CHECK (component_class IN ('RED_CELLS', 'WHOLE_BLOOD', 'PLASMA', 'PLATELETS', 'CRYO'));</sql>
        <createSequence sequenceName="blood_product_type_seq" schemaName="clinlims" startValue="1" incrementBy="1"/>
        <rollback>
            <dropSequence sequenceName="blood_product_type_seq" schemaName="clinlims"/>
            <dropTable tableName="blood_product_type" schemaName="clinlims"/>
        </rollback>
    </changeSet>

    <changeSet id="bloodbank-002-product-code" author="openelisglobal">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="blood_product_code" schemaName="clinlims"/></not>
        </preConditions>
        <comment>ISBT 128 product code (or its leading characters) mapped to a component type</comment>
        <createTable tableName="blood_product_code" schemaName="clinlims">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="isbt_code_prefix" type="VARCHAR(8)"><constraints nullable="false" unique="true" uniqueConstraintName="uq_blood_product_code_prefix"/></column>
            <column name="product_type_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_blood_product_code_type" referencedTableSchemaName="clinlims" referencedTableName="blood_product_type" referencedColumnNames="id"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="NOW()"/>
        </createTable>
        <createSequence sequenceName="blood_product_code_seq" schemaName="clinlims" startValue="1" incrementBy="1"/>
        <rollback>
            <dropSequence sequenceName="blood_product_code_seq" schemaName="clinlims"/>
            <dropTable tableName="blood_product_code" schemaName="clinlims"/>
        </rollback>
    </changeSet>

    <changeSet id="bloodbank-003-unit" author="openelisglobal">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="blood_unit" schemaName="clinlims"/></not>
        </preConditions>
        <comment>One physical blood unit. A donation splits into several components, so the identity is DIN plus product code.</comment>
        <createTable tableName="blood_unit" schemaName="clinlims">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="fhir_uuid" type="UUID"><constraints nullable="false" unique="true" uniqueConstraintName="uq_blood_unit_fhir_uuid"/></column>
            <column name="donation_number" type="VARCHAR(13)"><constraints nullable="false"/></column>
            <column name="product_code" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="product_type_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_blood_unit_product_type" referencedTableSchemaName="clinlims" referencedTableName="blood_product_type" referencedColumnNames="id"/>
            </column>
            <column name="abo" type="VARCHAR(2)"><constraints nullable="false"/></column>
            <column name="rhd" type="VARCHAR(3)"><constraints nullable="false"/></column>
            <column name="expires_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="collected_at" type="TIMESTAMP"/>
            <column name="supplier" type="VARCHAR(120)"/>
            <column name="volume_ml" type="INT"/>
            <column name="status" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="received_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="received_by" type="INT"><constraints nullable="false"/></column>
            <column name="patient_id" type="NUMERIC(10,0)">
                <constraints nullable="true" foreignKeyName="fk_blood_unit_patient" referencedTableSchemaName="clinlims" referencedTableName="patient" referencedColumnNames="id"/>
            </column>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="NOW()"/>
        </createTable>
        <addUniqueConstraint schemaName="clinlims" tableName="blood_unit" columnNames="donation_number, product_code" constraintName="uq_blood_unit_din_product"/>
        <sql>ALTER TABLE clinlims.blood_unit ADD CONSTRAINT chk_blood_unit_abo CHECK (abo IN ('O', 'A', 'B', 'AB'));</sql>
        <sql>ALTER TABLE clinlims.blood_unit ADD CONSTRAINT chk_blood_unit_rhd CHECK (rhd IN ('POS', 'NEG'));</sql>
        <sql>ALTER TABLE clinlims.blood_unit ADD CONSTRAINT chk_blood_unit_status
            CHECK (status IN ('AVAILABLE', 'QUARANTINED', 'RESERVED', 'ISSUED', 'TRANSFUSED', 'DISCARDED', 'RETURNED_TO_SUPPLIER'));</sql>
        <createIndex indexName="idx_blood_unit_status" tableName="blood_unit" schemaName="clinlims">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_blood_unit_patient" tableName="blood_unit" schemaName="clinlims">
            <column name="patient_id"/>
        </createIndex>
        <createSequence sequenceName="blood_unit_seq" schemaName="clinlims" startValue="1" incrementBy="1"/>
        <rollback>
            <dropSequence sequenceName="blood_unit_seq" schemaName="clinlims"/>
            <dropTable tableName="blood_unit" schemaName="clinlims"/>
        </rollback>
    </changeSet>

    <changeSet id="bloodbank-004-reservation" author="openelisglobal">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="blood_unit_reservation" schemaName="clinlims"/></not>
        </preConditions>
        <comment>A unit held for a patient, with the validated crossmatch result that covers it (none for plasma, platelets and cryo)</comment>
        <createTable tableName="blood_unit_reservation" schemaName="clinlims">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="unit_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_blood_reservation_unit" referencedTableSchemaName="clinlims" referencedTableName="blood_unit" referencedColumnNames="id"/>
            </column>
            <column name="patient_id" type="NUMERIC(10,0)">
                <constraints nullable="false" foreignKeyName="fk_blood_reservation_patient" referencedTableSchemaName="clinlims" referencedTableName="patient" referencedColumnNames="id"/>
            </column>
            <column name="crossmatch_result_id" type="NUMERIC(10,0)"/>
            <column name="crossmatch_valid_until" type="TIMESTAMP"/>
            <column name="status" type="VARCHAR(12)"><constraints nullable="false"/></column>
            <column name="reserved_by" type="INT"><constraints nullable="false"/></column>
            <column name="reserved_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="issued_at" type="TIMESTAMP"/>
            <column name="closed_at" type="TIMESTAMP"/>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="NOW()"/>
        </createTable>
        <sql>ALTER TABLE clinlims.blood_unit_reservation ADD CONSTRAINT chk_blood_reservation_status
            CHECK (status IN ('ACTIVE', 'ISSUED', 'RELEASED', 'EXPIRED'));</sql>
        <!-- one live reservation per unit, and one crossmatch result covers one unit only -->
        <sql>CREATE UNIQUE INDEX uq_blood_reservation_active_unit ON clinlims.blood_unit_reservation (unit_id) WHERE status = 'ACTIVE';</sql>
        <sql>CREATE UNIQUE INDEX uq_blood_reservation_crossmatch ON clinlims.blood_unit_reservation (crossmatch_result_id)
            WHERE crossmatch_result_id IS NOT NULL AND status IN ('ACTIVE', 'ISSUED');</sql>
        <createIndex indexName="idx_blood_reservation_patient" tableName="blood_unit_reservation" schemaName="clinlims">
            <column name="patient_id"/>
        </createIndex>
        <createSequence sequenceName="blood_unit_reservation_seq" schemaName="clinlims" startValue="1" incrementBy="1"/>
        <rollback>
            <dropSequence sequenceName="blood_unit_reservation_seq" schemaName="clinlims"/>
            <dropTable tableName="blood_unit_reservation" schemaName="clinlims"/>
        </rollback>
    </changeSet>

    <changeSet id="bloodbank-005-event" author="openelisglobal">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="blood_unit_event" schemaName="clinlims"/></not>
        </preConditions>
        <comment>Append-only traceability trail: one row per thing that happened to a unit</comment>
        <createTable tableName="blood_unit_event" schemaName="clinlims">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="unit_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_blood_event_unit" referencedTableSchemaName="clinlims" referencedTableName="blood_unit" referencedColumnNames="id"/>
            </column>
            <column name="event_type" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="patient_id" type="NUMERIC(10,0)">
                <constraints nullable="true" foreignKeyName="fk_blood_event_patient" referencedTableSchemaName="clinlims" referencedTableName="patient" referencedColumnNames="id"/>
            </column>
            <column name="reservation_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_blood_event_reservation" referencedTableSchemaName="clinlims" referencedTableName="blood_unit_reservation" referencedColumnNames="id"/>
            </column>
            <column name="performed_by" type="INT"><constraints nullable="false"/></column>
            <column name="second_checker_id" type="INT"/>
            <column name="occurred_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="location" type="VARCHAR(120)"/>
            <column name="collector_name" type="VARCHAR(120)"/>
            <column name="details" type="TEXT"/>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="NOW()"/>
        </createTable>
        <sql>ALTER TABLE clinlims.blood_unit_event ADD CONSTRAINT chk_blood_event_type
            CHECK (event_type IN ('RECEIVED', 'QUARANTINED', 'RELEASED', 'RESERVED', 'UNRESERVED', 'ISSUED', 'RETURNED',
                                  'TRANSFUSED', 'REACTION', 'DISCARDED', 'RETURNED_TO_SUPPLIER'));</sql>
        <createIndex indexName="idx_blood_event_unit" tableName="blood_unit_event" schemaName="clinlims">
            <column name="unit_id"/>
        </createIndex>
        <createIndex indexName="idx_blood_event_patient" tableName="blood_unit_event" schemaName="clinlims">
            <column name="patient_id"/>
        </createIndex>
        <createSequence sequenceName="blood_unit_event_seq" schemaName="clinlims" startValue="1" incrementBy="1"/>
        <rollback>
            <dropSequence sequenceName="blood_unit_event_seq" schemaName="clinlims"/>
            <dropTable tableName="blood_unit_event" schemaName="clinlims"/>
        </rollback>
    </changeSet>

    <changeSet id="bloodbank-006-event-append-only" author="openelisglobal">
        <comment>The trail cannot be edited or deleted row by row, whatever path the change comes from. TRUNCATE (whole-database resets) is not blocked.</comment>
        <sql splitStatements="false">
            CREATE OR REPLACE FUNCTION clinlims.blood_unit_event_append_only() RETURNS trigger AS $$
            BEGIN
                RAISE EXCEPTION 'blood_unit_event is append-only: % refused', TG_OP;
            END;
            $$ LANGUAGE plpgsql;
        </sql>
        <sql>CREATE TRIGGER blood_unit_event_no_update_delete BEFORE UPDATE OR DELETE ON clinlims.blood_unit_event
            FOR EACH ROW EXECUTE FUNCTION clinlims.blood_unit_event_append_only();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS blood_unit_event_no_update_delete ON clinlims.blood_unit_event;</sql>
            <sql>DROP FUNCTION IF EXISTS clinlims.blood_unit_event_append_only();</sql>
        </rollback>
    </changeSet>

    <changeSet id="bloodbank-007-seed-product-types" author="openelisglobal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM clinlims.blood_product_type</sqlCheck>
        </preConditions>
        <comment>Four generic component types; sites add their own and map their ISBT 128 product codes to them</comment>
        <insert tableName="blood_product_type" schemaName="clinlims">
            <column name="id" valueSequenceNext="blood_product_type_seq"/>
            <column name="code" value="RED_CELLS"/>
            <column name="name" value="Red cells"/>
            <column name="component_class" value="RED_CELLS"/>
            <column name="requires_crossmatch" valueBoolean="true"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="blood_product_type" schemaName="clinlims">
            <column name="id" valueSequenceNext="blood_product_type_seq"/>
            <column name="code" value="FFP"/>
            <column name="name" value="Fresh frozen plasma"/>
            <column name="component_class" value="PLASMA"/>
            <column name="requires_crossmatch" valueBoolean="false"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="blood_product_type" schemaName="clinlims">
            <column name="id" valueSequenceNext="blood_product_type_seq"/>
            <column name="code" value="PLATELETS"/>
            <column name="name" value="Platelets"/>
            <column name="component_class" value="PLATELETS"/>
            <column name="requires_crossmatch" valueBoolean="false"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="blood_product_type" schemaName="clinlims">
            <column name="id" valueSequenceNext="blood_product_type_seq"/>
            <column name="code" value="CRYO"/>
            <column name="name" value="Cryoprecipitate"/>
            <column name="component_class" value="CRYO"/>
            <column name="requires_crossmatch" valueBoolean="false"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <rollback>
            <delete tableName="blood_product_type" schemaName="clinlims">
                <where>code IN ('RED_CELLS', 'FFP', 'PLATELETS', 'CRYO')</where>
            </delete>
        </rollback>
    </changeSet>

